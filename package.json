{
  "name": "dsh-imagegen",
  "version": "0.1.0",
  "private": true,
  "description": "Provider-neutral image generation tool for DeepSeek Harness",
  "homepage": "https://github.com/laishaojue-commits/dsh-imagegen#readme",
  "bugs": { "url": "https://github.com/laishaojue-commits/dsh-imagegen/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/laishaojue-commits/dsh-imagegen.git" },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "image-generation",
    "gemini",
    "openai-images"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && node --check client.js && node --check request-policy.js && node --check runtime-imports.js",
    "test:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-desktop.ps1"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "runtime-imports.js",
    "request-policy.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "react": ">=18 <20",
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
